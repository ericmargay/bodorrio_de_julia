# Railway inyecta esta variable automáticamente cuando agregas el plugin
# de PostgreSQL a este servicio. Para desarrollo local, apunta a tu propio
# Postgres (ver README.md del servidor).
DATABASE_URL=postgres://user:password@localhost:5432/boda

# Pon "require" si tu proveedor de Postgres exige SSL (Railway público sí).
PGSSLMODE=disable

# Contraseña del panel admin (NUNCA la pongas en el HTML, solo aquí).
ADMIN_PASSWORD=cambia-esto

# Secreto para firmar los tokens de sesión del panel admin.
JWT_SECRET=cambia-esto-tambien-por-algo-largo-y-aleatorio

# Orígenes permitidos para CORS, separados por coma.
# Incluye el dominio de GitHub Pages donde vive index.html.
ALLOWED_ORIGINS=https://ericmargay.github.io,http://localhost:5500,http://127.0.0.1:5500

PORT=3000
